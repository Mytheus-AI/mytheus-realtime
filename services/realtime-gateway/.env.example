# realtime-gateway — Socket.io fan-out plane. Copy to .env for local dev.
PORT=8090
WS_BIND_HOST=0.0.0.0
REDIS_URL=redis://localhost:6380
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
# Clerk JWKS endpoint used to verify the WS handshake JWT (fail closed if unset in production).
# No live Clerk instance exists yet in dev; see test/helpers/fakeJwks.ts for the local stand-in
# used by the test suite.
CLERK_JWKS_URL=
# core-api owns `chat_messages` and meeting participant roster; the gateway calls it for the
# durable chat write (POST /chat) and the deny-by-default participant check on room join.
CORE_API_URL=http://localhost:8000
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional presence tuning; unset uses the production defaults (15s/45s/20s, see server.ts's
# AppConfig doc comments). Mainly useful to set short for tests that need to observe a full
# heartbeat -> stale -> sweep cycle without waiting out the production defaults.
PRESENCE_HEARTBEAT_INTERVAL_MS=
PRESENCE_STALE_AFTER_MS=
PRESENCE_SWEEP_INTERVAL_MS=
