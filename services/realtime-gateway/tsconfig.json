{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // `rootDir` is widened to the repo root (not `src`) so this project can compile the shared
  // `../../libs/**` module tree alongside `src/**`; output mirrors that under `dist/`, hence
  // `dist/services/realtime-gateway/src/server.js` in package.json's `main`/`start`. `test/**` is
  // included so `npm run typecheck` (this same config) covers the tests too; vitest runs the
  // tests directly (esbuild transpile) and does not depend on this compiled `dist/` output.
  "include": ["src/**/*.ts", "test/**/*.ts", "../../libs/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
