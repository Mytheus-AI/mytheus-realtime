# transcription-service — LiveKit audio hook -> Deepgram WSS proxy. Copy to .env for local dev.
REDIS_URL=redis://localhost:6380
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Postgres (transcript_chunks writes; finals only, RLS by org_id). Same physical Postgres
# mytheus-backend migrates; this service owns and migrates only transcript_chunks (see
# migrations/), and reads tenant_settings/data_residency + writes outbox directly against it.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/mytheus

# Internal WS bind for the LiveKit server-side audio hook.
TRANSCRIPTION_WS_BIND=0.0.0.0:8091

# /internal/audio shared secret: the sender (meeting-service's audio tap) presents this in the
# X-Internal-Auth header. Unset = every connection refused (fail closed). Set a long random
# value locally (e.g. `openssl rand -hex 32`) and the SAME value on the sender side. Never
# commit a real value.
INTERNAL_AUDIO_TOKEN=
# Optional /internal/audio limits; unset uses the defaults shown.
AUDIO_INIT_TIMEOUT_SECONDS=10
AUDIO_IDLE_TIMEOUT_SECONDS=30
AUDIO_MAX_FRAME_BYTES=65536
AUDIO_QUEUE_MAX_FRAMES=100

# LiveKit — validates the audio-hook handshake. Unavailable in this band (no LiveKit account
# yet, same as meeting-service's documented deviation); leave unset for local dev.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram — stays server-side, never sent to the client. Leave unset: the compliance gate
# (src/transcription_service/compliance.py) refuses to open a real stream regardless of
# whether this is set (condition 1, a signed DPA/SCC, is unmet).
DEEPGRAM_API_KEY=

# With DEEPGRAM_API_KEY unset, the service FAILS CLOSED (refuses every /internal/audio
# connection) unless this is exactly 1. Set it to 1 only for local development: the fake
# provider emits scripted text and must never transcribe a real tenant meeting.
TRANSCRIPTION_ALLOW_FAKE_PROVIDER=0

OTEL_EXPORTER_OTLP_ENDPOINT=
