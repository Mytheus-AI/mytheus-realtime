# transcription-service — LiveKit audio hook -> Deepgram WSS proxy. Copy to .env for local dev.
REDIS_URL=redis://localhost:6380
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Postgres (transcript_chunks writes; finals only, RLS by org_id). Same physical Postgres
# mytheus-backend migrates; this service owns and migrates only transcript_chunks (see
# migrations/), and reads tenant_settings/data_residency + writes outbox directly against it.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/mytheus

# Internal WS bind for the LiveKit server-side audio hook.
TRANSCRIPTION_WS_BIND=0.0.0.0:8091

# LiveKit — validates the audio-hook handshake. Unavailable in this band (no LiveKit account
# yet, same as meeting-service's documented deviation); leave unset for local dev.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram — stays server-side, never sent to the client. Leave unset: the compliance gate
# (src/transcription_service/compliance.py) refuses to open a real stream regardless of
# whether this is set (condition 1, a signed DPA/SCC, is unmet). Unset selects FakeProvider.
DEEPGRAM_API_KEY=

OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Reversible PII redaction (ADR-0020 / ADR-0024) ---
# All three are OPTIONAL and unset is a supported, tested state, not a broken one. With none of
# them set, this service redacts exactly as it did before the vault existed: the deterministic
# regex layer only, with irreversible `<TYPE>` placeholders. See pii_pipeline.py for the four
# degraded outcomes and why none is ever weaker than that baseline.

# ner-service in mytheus-intelligence. Unset => no NER pass; finals are written with
# transcript_chunks.partially_redacted = true, and a tenant whose ner_unavailable_policy is
# `drop` has their finals discarded instead.
NER_SERVICE_URL=

# identity-tenant-service in mytheus-backend, the sole writer of pii_tokens. Unset => the
# deterministic and NER spans are still redacted, just irreversibly.
PII_VAULT_URL=

# The workload credential both of the above are called with (libs/shared/internal_auth.py in
# both repos). No default anywhere: an auth mechanism with a default is one that is off in
# exactly the deployment nobody checked. Must be >= 32 characters and identical across every
# service that calls or serves an internal route.
INTERNAL_SERVICE_TOKEN=
