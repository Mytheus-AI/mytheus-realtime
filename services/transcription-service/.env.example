# transcription-service — LiveKit audio hook -> Deepgram WSS proxy. Copy to .env for local dev.
REDIS_URL=redis://localhost:6379
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# Postgres (transcript_chunks writes; finals only, RLS by org_id).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mytheus

# Deepgram — stays server-side, never sent to the client.
DEEPGRAM_API_KEY=
